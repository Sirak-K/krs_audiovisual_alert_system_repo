<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="utf-8">
  <title>Codex svar klart</title>
  <HTA:APPLICATION
    APPLICATIONNAME="CodexPopup"
    BORDER="none"
    BORDERSTYLE="normal"
    CAPTION="no"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="no"
    SCROLL="no"
    SHOWINTASKBAR="no"
    SINGLEINSTANCE="no"
    SYSMENU="no"
    WINDOWSTATE="normal"
  />
  <style>
    html, body {
      margin: 0;
      padding: 0;
      background: #08111f;
      color: #ffd7a3;
      font-family: "Conthrax SB", "Conthrax", "Unispace", "Segoe UI", sans-serif;
      overflow: hidden;
    }
    body {
      border: 1px solid #ff9d3d;
      background: #091426;
      filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#08111f', endColorstr='#132549', GradientType=1);
    }
    .wrap {
      padding: 0;
      position: relative;
      height: 100%;
    }
    .chrome {
      height: 30px;
      background: #020508;
      border-bottom: 1px solid #ff8e28;
      color: #ffb96a;
      position: relative;
    }
    .chromeTitle {
      padding: 8px 12px 0;
      font-size: 12px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }
    .chromeClose {
      position: absolute;
      top: 4px;
      right: 6px;
      width: 24px;
      height: 22px;
      line-height: 20px;
      text-align: center;
      border: 1px solid #ff8e28;
      background: #1a0600;
      color: #ffd7a3;
      cursor: pointer;
      font-family: "Segoe UI", sans-serif;
      font-size: 14px;
      font-weight: 700;
    }
    .chromeClose:focus {
      outline: 2px solid #ffd9a0;
      outline-offset: 1px;
    }
    .content {
      position: relative;
      width: 360px;
      margin: 0 auto;
      padding: 24px 0 14px;
      height: 172px;
    }
    .frame {
      position: absolute;
      top: 38px;
      left: 10px;
      right: 10px;
      bottom: 8px;
      border: 1px solid #274974;
    }
    .innerFrame {
      position: absolute;
      top: 42px;
      left: 14px;
      right: 14px;
      bottom: 12px;
      border: 1px solid #0f2748;
    }
    .beamTop {
      position: absolute;
      top: 38px;
      left: 10px;
      right: 86px;
      height: 2px;
      background: #ff9d3d;
      filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#ff6f14', endColorstr='#ffdcb2', GradientType=1);
    }
    .beamBottom {
      position: absolute;
      left: 86px;
      right: 10px;
      bottom: 8px;
      height: 2px;
      background: #ff9d3d;
      filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#ffdcb2', endColorstr='#ff6f14', GradientType=1);
    }
    .sheen {
      position: absolute;
      top: 46px;
      left: 16px;
      right: 16px;
      height: 38px;
      background: #1e4d89;
      filter: alpha(opacity=12);
    }
    .sheenTwo {
      position: absolute;
      top: 84px;
      right: 22px;
      width: 120px;
      height: 20px;
      background: #ff8e28;
      filter: alpha(opacity=9);
    }
    .cornerL {
      position: absolute;
      top: 48px;
      left: 18px;
      width: 26px;
      height: 10px;
      border-left: 2px solid #ff9d3d;
      border-top: 2px solid #ff9d3d;
    }
    .cornerR {
      position: absolute;
      top: 48px;
      right: 18px;
      width: 26px;
      height: 10px;
      border-right: 2px solid #ff9d3d;
      border-top: 2px solid #ff9d3d;
    }
    .title {
      position: relative;
      font-size: 30px;
      font-weight: 700;
      width: 300px;
      margin: 10px auto 14px;
      color: #b8ff38;
      letter-spacing: 2px;
      text-transform: uppercase;
      line-height: 1.05;
      text-align: center;
    }
    .body {
      position: relative;
      font-family: "Conthrax", "Unispace", "Segoe UI", sans-serif;
      font-size: 12px;
      line-height: 1.45;
      width: 320px;
      margin-left: auto;
      margin-right: auto;
      margin-bottom: 14px;
      word-wrap: break-word;
      color: #ffe7c4;
    }
    .actions {
      position: relative;
      width: 320px;
      margin: 0 auto;
      text-align: right;
    }
    button {
      position: relative;
      font: inherit;
      padding: 5px 14px;
      border: 1px solid #ff9d3d;
      background: #ff9d3d;
      filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#ffcb75', endColorstr='#ff7a1a', GradientType=0);
      color: #1b1208;
      cursor: pointer;
      font-weight: 700;
      text-transform: uppercase;
    }
    button:focus {
      outline: 2px solid #ffd9a0;
      outline-offset: 1px;
    }
  </style>
  <script type="text/javascript">
    function parseQuery() {
      var result = {};
      var query = window.location.search || "";
      if (query.charAt(0) === "?") {
        query = query.substring(1);
      }
      if (!query) {
        return result;
      }
      var parts = query.split("&");
      for (var i = 0; i < parts.length; i += 1) {
        if (!parts[i]) {
          continue;
        }
        var pair = parts[i].split("=");
        var key = decodeURIComponent(pair[0] || "");
        var value = decodeURIComponent((pair.slice(1).join("=") || "").replace(/\+/g, " "));
        result[key] = value;
      }
      return result;
    }

    function closePopup() {
      window.close();
    }

    function handleKey(event) {
      var code = event.keyCode || event.which;
      if (code === 27 || code === 13) {
        closePopup();
        return false;
      }
      return true;
    }

    function init() {
      var params = parseQuery();
      var title = params.title || "Codex svar klart";
      var body = params.body || "Agentens svar är klart.";
      var timeoutSeconds = parseInt(params.timeout || "2", 10);
      if (!(timeoutSeconds > 0)) {
        timeoutSeconds = 2;
      }

      document.title = title;
      document.getElementById("chromeTitle").innerText = "KRS Pop-Up Alert";
      document.getElementById("title").innerText = title;
      document.getElementById("body").innerText = body;
      window.resizeTo(460, 240);
      window.moveTo(
        Math.max(0, Math.round((screen.availWidth - 460) / 2)),
        Math.max(0, Math.round(screen.availHeight * 0.58) - 120)
      );
      window.setTimeout(closePopup, timeoutSeconds * 1000);
      document.body.focus();
      window.focus();
    }
  </script>
</head>
<body onload="init()" onkeydown="return handleKey(event)" tabindex="0">
  <div class="wrap">
    <div class="chrome">
      <div class="chromeTitle" id="chromeTitle">KRS Pop-Up Alert</div>
      <button class="chromeClose" type="button" onclick="closePopup()" title="Stäng">×</button>
    </div>
    <div class="frame"></div>
    <div class="innerFrame"></div>
    <div class="beamTop"></div>
    <div class="beamBottom"></div>
    <div class="sheen"></div>
    <div class="sheenTwo"></div>
    <div class="cornerL"></div>
    <div class="cornerR"></div>
    <div class="content">
      <div class="title" id="title">Codex svar klart</div>
      <div class="body" id="body">Agentens svar är klart.</div>
      <div class="actions">
        <button type="button" onclick="closePopup()">Stäng</button>
      </div>
    </div>
  </div>
</body>
</html>
